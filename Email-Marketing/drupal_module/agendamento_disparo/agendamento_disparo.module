<?php

/**
 * @file
 * Contém regras de negócio para o módulo Agendamento de Disparo.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_alter().
 */
function agendamento_disparo_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Intercepta os formulários de criação e edição do content type "agendamento_disparo".
  if (in_array($form_id, ['node_agendamento_disparo_form', 'node_agendamento_disparo_edit_form'])) {
    $form['#validate'][] = 'agendamento_disparo_slot_validation';
  }
}

/**
 * Custom validation handler for agendamento_disparo.
 */
function agendamento_disparo_slot_validation(&$form, FormStateInterface $form_state) {
  $data_field = $form_state->getValue('field_data');
  $periodo_field = $form_state->getValue('field_periodo');
  
  if (!empty($data_field[0]['value']) && !empty($periodo_field[0]['value'])) {
    $data_solicitada = $data_field[0]['value'];
    $periodo_solicitado = $periodo_field[0]['value'];

    // Recuperar a entidade atual em edição, se houver (para não validar contra ela mesma).
    $node = $form_state->getFormObject()->getEntity();
    $node_id = $node->id();

    // Query para verificar se já existe um agendamento na mesma data/período.
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'agendamento_disparo')
      ->condition('field_data', $data_solicitada)
      ->condition('field_periodo', $periodo_solicitado)
      ->accessCheck(FALSE);

    if ($node_id) {
      $query->condition('nid', $node_id, '<>'); // Exclui o node atual da busca.
    }

    $nids = $query->execute();

    if (!empty($nids)) {
      // Já existe um disparo ocupando esse slot de calendário.
      $form_state->setErrorByName('field_data', t('Já existe um agendamento para a mesma data e período selecionados. Por favor, escolha outro horário.'));
    }
  }
}
